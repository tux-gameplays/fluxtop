{
  "name": "fluxtop-installer",
  "version": "1.0.0",
  "description": "Installer for Fluxtop — Fluxer mod loader",
  "private": true,
  "main": "gui/main.js",
  "scripts": {
    "cli": "node cli/index.js",
    "gui": "electron gui/main.js",
    "build": "node build.js"
  },
  "fluxtop": {
    "githubRepo": "tux-gameplays/fluxtop"
  },
  "dependencies": {
    "@electron/asar": "^3.2.13",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "latest",
    "electron": "^41.0.0",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "dev.fluxtop.installer",
    "productName": "Fluxtop Installer",
    "copyright": "Reflux contributors",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "files": [
      "gui/**/*",
      "lib/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "fluxtop-v${version}-win-x64-setup.exe"
    },
    "linux": {
      "target": ["AppImage"],
      "artifactName": "fluxtop-v${version}-linux-x64-setup.AppImage",
      "category": "Utility"
    }
  }
}
